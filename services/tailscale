#!/bin/bash
# /userdata/system/services/tailscale

set -u

WATCHDOG="/userdata/tailscale/watchdog.sh"
PIDFILE="/var/run/tailscale-watchdog.pid"

is_running() {
  [ -f "$PIDFILE" ] || return 1
  local pid
  pid="$(cat "$PIDFILE" 2>/dev/null)" || return 1
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null
}

start() {
  echo -n "Starting Tailscale: "

  if [ ! -x "$WATCHDOG" ]; then
    echo "failed (watchdog not executable: $WATCHDOG)"
    return 1
  fi

  mkdir -p "$(dirname "$PIDFILE")"

  if is_running; then
    echo "already running"
    return 0
  fi

  rm -f "$PIDFILE"

  start-stop-daemon -S -b -m -p "$PIDFILE" --exec "$WATCHDOG" >/dev/null 2>&1
  local rc=$?

  if [ $rc -eq 0 ] && is_running; then
    echo "done"
    return 0
  fi

  echo "failed"
  return 1
}

stop() {
  echo -n "Stopping Tailscale: "

  if is_running; then
    start-stop-daemon -K -p "$PIDFILE" >/dev/null 2>&1 || true
  fi

  # Give watchdog/monitor a moment to shut down cleanly.
  sleep 2

  # Best-effort: in case tailscaled was orphaned.
  killall tailscaled 2>/dev/null || true

  rm -f "$PIDFILE"
  echo "done"
  return 0
}

status() {
  if is_running; then
    echo "Tailscale watchdog: started"
    if pgrep -x tailscaled >/dev/null 2>&1; then
      echo "Tailscale daemon: running"
      /userdata/tailscale/tailscale status 2>/dev/null || echo "Tailscale: not connected"
    else
      echo "Tailscale daemon: stopped"
    fi
  else
    [ -f "$PIDFILE" ] && rm -f "$PIDFILE"
    echo "Tailscale watchdog: stopped"
  fi
}

restart() { stop; sleep 2; start; }

case "${1:-}" in
  start|stop|status|restart) "$1" ;;
  *) echo "Usage: $0 {start|stop|status|restart}"; exit 1 ;;
esac